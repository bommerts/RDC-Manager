// RDC Manager - icon and version information
#include <winver.h>

1 ICON "rdcm.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "bommerts"
            VALUE "FileDescription",  "RDC Manager"
            VALUE "FileVersion",      "1.1.0"
            VALUE "InternalName",     "RDCManager"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "RDCManager.exe"
            VALUE "ProductName",      "RDC Manager"
            VALUE "ProductVersion",   "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
